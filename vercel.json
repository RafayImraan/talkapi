{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "outputDirectory": "frontend/dist",
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "cd frontend && npm install"
}
